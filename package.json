{
  "name": "sunday-kachinuki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun --no-env-file scripts/run-web.ts dev",
    "build": "bun scripts/deploy-guard.ts && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "bun test src scripts",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "db:stop": "supabase stop",
    "test:db": "bun run db:start && bun run db:reset && supabase test db --local",
    "test:e2e": "bun run db:start && bun run db:reset && playwright test"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@fontsource/shippori-mincho-b1": "5.3.0",
    "@supabase/supabase-js": "2.111.0",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.34",
    "nitro": "3.0.260610-beta",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.55.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "9.39.5",
    "supabase": "2.111.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0"
  }
}
